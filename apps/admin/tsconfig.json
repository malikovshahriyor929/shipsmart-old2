{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "esnext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "paths": {
      "@/*": ["./src/*"],
      "@public/*": ["./public/*"],
      "@shared/*": ["./src/app/shared*"],
      "@core/*": ["../../packages/isomorphic-core/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "extends": "@shipsmart/typescript-config/nextjs.json",
  "include": [
    "next-env.d.ts",
    "additional.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.cjs",
    "**/*.mjs",
    ".next/types/**/*.ts"
, "../../packages/isomorphic-core/src/components/photoViewer.tsx"  ],
  "exclude": ["node_modules"]
}
